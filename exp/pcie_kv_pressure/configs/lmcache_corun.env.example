# Source this file and override values before running run_synthetic_pressure.sh.
# It is a template only; it does not get sourced automatically.

MODEL="${MODEL:-Qwen/Qwen3-8B}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
VLLM_PORT="${VLLM_PORT:-8000}"

LMCACHE_CPU_SIZE_GB="${LMCACHE_CPU_SIZE_GB:-32}"
LMCACHE_DISK_SIZE_GB="${LMCACHE_DISK_SIZE_GB:-128}"
LMCACHE_DISK_PATH="${LMCACHE_DISK_PATH:-/tmp/lmcache_kv/${RUN_ID:-pcie_kv_pressure}/gpu0}"
LMCACHE_INTERNAL_API_SERVER_PORT_START="${LMCACHE_INTERNAL_API_SERVER_PORT_START:-6999}"

export CUDA_VISIBLE_DEVICES
export LMCACHE_INTERNAL_API_SERVER_ENABLED=true
export LMCACHE_INTERNAL_API_SERVER_HOST=127.0.0.1
export LMCACHE_INTERNAL_API_SERVER_PORT_START
export LMCACHE_LOCAL_CPU=true
export LMCACHE_MAX_LOCAL_CPU_SIZE="${LMCACHE_CPU_SIZE_GB}"
export LMCACHE_LOCAL_DISK="${LMCACHE_DISK_PATH}"
export LMCACHE_LOCAL_DISK_PATH_SHARDING="${LMCACHE_LOCAL_DISK_PATH_SHARDING:-by_gpu}"
export LMCACHE_MAX_LOCAL_DISK_SIZE="${LMCACHE_DISK_SIZE_GB}"

PRE_HOOK_CMD="mkdir -p ${LMCACHE_DISK_PATH}"

VLLM_LMCACHE_SERVE_CMD="vllm serve ${MODEL} \
  --port ${VLLM_PORT} \
  --kv-offloading-size ${LMCACHE_CPU_SIZE_GB} \
  --kv-offloading-backend lmcache"

VLLM_METRICS_URL="http://127.0.0.1:${VLLM_PORT}/metrics"
SERVE_HEALTH_URL="http://127.0.0.1:${VLLM_PORT}/health"
LMCACHE_METRICS_URLS="http://127.0.0.1:${LMCACHE_INTERNAL_API_SERVER_PORT_START}/metrics"

# Optional: after generating a trace, use this as EXTRA_CORUN_CMD so the launcher
# captures serving results in the same run directory.
TRACE_DIR="${TRACE_DIR:-exp/pcie_kv_pressure/traces/high_reuse}"
CLIENT_REPLAY_CMD="python ../hiddencache/workload_generator/replay_trace.py \
  --trace ${TRACE_DIR}/trace.jsonl \
  --prefix-bank ${TRACE_DIR}/prefix_bank.jsonl \
  --results \${RUN_DIR}/client_results.jsonl \
  --base-url http://127.0.0.1:${VLLM_PORT}/v1 \
  --model ${MODEL} \
  --endpoint completions \
  --mode open-loop \
  --max-workers 256"
